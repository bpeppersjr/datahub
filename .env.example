# The runner binds to the local machine by default.
RUNNER_HOST=127.0.0.1
RUNNER_PORT=4300

# Required only for ZIP place segment jobs. Keep this value in .env; never add
# the key directly to a job definition.
GOOGLE_MAPS_API_KEY=

# Required only for official Florida Sunbiz quarterly SFTP acquisition. Copy
# the current public-source password from the official Data Downloads page;
# never commit the populated .env file.
FL_SUNBIZ_PUBLIC_PASSWORD=
