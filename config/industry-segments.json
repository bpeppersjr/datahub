{
  "version": 1,
  "max_concurrency": 10,
  "states": ["AL", "AK", "AZ", "AR", "CA", "CO", "CT", "DE", "DC", "FL", "GA", "HI", "ID", "IL", "IN", "IA", "KS", "KY", "LA", "ME", "MD", "MA", "MI", "MN", "MS", "MO", "MT", "NE", "NV", "NH", "NJ", "NM", "NY", "NC", "ND", "OH", "OK", "OR", "PA", "RI", "SC", "SD", "TN", "TX", "UT", "VT", "VA", "WA", "WV", "WI", "WY"],
  "industries": {
    "retail-consumer": ["national-snap-retailers", "state-ny-retail-food", "state-ca-abc"],
    "health-care": ["national-nppes-organizations"],
    "financial-services": ["national-fdic-bankfind", "national-ncua-quarterly"],
    "transportation": ["national-fmcsa-census"],
    "construction": ["state-wa-contractors"],
    "tax-exempt-organizations": ["national-irs-eo-bmf"],
    "sales-tax-outlets": ["state-tx-sales-tax"],
    "local-business-licenses": ["state-dc-basic-licenses"]
  },
  "sources": {
    "state-dc-basic-licenses": {
      "script": "scripts/build-dc-basic-business-licenses.mjs",
      "scope": "state",
      "states": ["DC"],
      "state_filter_supported": false,
      "prerequisites": ["data/business-baselines/census-zbp/current.json"],
      "coverage_notes": [
        "Cross-industry District of Columbia Basic Business License evidence, not a retail-only classification or a census of every business. DC selection scopes the publisher jurisdiction; reported out-of-district premises remain source claims rather than being silently dropped.",
        "Active is a source-defined license status, not independent proof of current operations, occupancy or public access. Multiple activity rows for one Customer Number form one provisional customer/premise group.",
        "Selected source rows stay internal; normalized records remain local-review-only. Owner, agent, billing and parcel fields are excluded. Aggregate reuse requires DLCP/Open Data DC attribution and CC BY 4.0 notice. No parent company or cross-source identity is inferred."
      ]
    },
    "national-irs-eo-bmf": {
      "script": "scripts/build-irs-eo-bmf.mjs",
      "scope": "national",
      "states": "all",
      "state_filter_supported": false,
      "prerequisites": ["data/business-baselines/census-zbp/current.json"],
      "coverage_notes": [
        "Cross-industry IRS current-extract membership and reported filing addresses are not proof of ongoing operations or physical premises, and do not cover every nonprofit or tax-exempt organization.",
        "Raw regional CSVs remain internal. Only policy-approved normalized fields may be exported; personal contact and financial amount fields are excluded."
      ]
    },
    "national-nppes-organizations": {
      "script": "scripts/build-cms-nppes-organizations.mjs",
      "scope": "national",
      "states": "all",
      "state_filter_supported": false,
      "prerequisites": ["data/business-baselines/census-zbp/current.json", "data/pharmacy-sources/nppes"]
    },
    "national-snap-retailers": {
      "script": "scripts/build-usda-snap-retailers.mjs",
      "scope": "national",
      "states": "all",
      "state_filter_supported": false,
      "prerequisites": ["data/business-baselines/census-zbp/current.json"]
    },
    "national-fdic-bankfind": {
      "script": "scripts/build-fdic-bankfind.mjs",
      "scope": "national",
      "states": "all",
      "state_filter_supported": false,
      "prerequisites": ["data/business-baselines/census-zbp/current.json"]
    },
    "national-ncua-quarterly": {
      "script": "scripts/build-ncua-quarterly.mjs",
      "scope": "national",
      "states": "all",
