    },
    "state-ny-retail-food": {
      "script": "scripts/build-ny-retail-food-stores.mjs",
      "scope": "state",
      "states": ["NY"],
      "state_filter_supported": true,
      "prerequisites": ["data/business-baselines/census-zbp/current.json"]
    },
    "state-ca-abc": {
      "script": "scripts/build-ca-abc-active-license-sites.mjs",
      "scope": "state",
      "states": ["CA"],
      "state_filter_supported": true,
