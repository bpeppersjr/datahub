  "configuration_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["input", "source_month", "source_version", "sha256", "bytes", "permission_reference", "zip_class_declaration"],
    "properties": {
      "input": { "type": "string" },
      "source_month": { "type": "string" },
      "source_version": { "type": "string" },
      "sha256": { "type": "string" },
      "bytes": { "type": "integer" },
      "permission_reference": { "type": "string" },
      "zip_class_declaration": { "type": "object" }
    }
  },
  "named_secret_references": [],
