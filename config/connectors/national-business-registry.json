{
  "connector_id": "national-business-registry",
  "version": "1.0.0",
  "description": "Reconciles governed record-level source releases into canonical business entities, assertions, relationships, and ZIP coverage without overstating completeness.",
  "lifecycle": ["preflight", "plan", "acquire", "validate", "normalize", "reconcile", "quality gate", "publish", "finalize"],
  "configuration_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "output": { "type": "string", "default": "data/business-registry" },
      "snap_pointer": { "type": "string", "default": "data/business-sources/usda-snap/current.json" },
      "nppes_pointer": { "type": "string", "default": "data/business-sources/cms-nppes-organizations/current.json" },
      "fdic_pointer": { "type": "string", "default": "data/business-sources/fdic-bankfind/current.json" },
      "ncua_pointer": { "type": "string", "default": "data/business-sources/ncua-quarterly-credit-unions/current.json" },
      "fsis_pointer": { "type": "string", "default": "data/business-sources/fsis-active-mpi-establishments/current.json" }
    }
  },
  "named_secret_references": [],
  "input_artifact_types": ["normalized-snap-retailer-jsonl-gzip", "snap-zip-coverage-jsonl", "normalized-nppes-organization-jsonl-gzip", "normalized-nppes-practice-location-jsonl-gzip", "normalized-nppes-other-name-jsonl-gzip", "nppes-organization-zip-coverage-jsonl", "normalized-fdic-institution-jsonl-gzip", "normalized-fdic-location-jsonl-gzip", "fdic-zip-coverage-jsonl", "normalized-ncua-institution-jsonl-gzip", "normalized-ncua-location-jsonl-gzip", "normalized-ncua-trade-name-jsonl-gzip", "ncua-zip-coverage-jsonl", "normalized-fsis-establishment-jsonl-gzip", "fsis-zip-coverage-jsonl"],
  "output_artifact_types": ["canonical-organization-jsonl-gzip", "canonical-physical-site-jsonl-gzip", "canonical-establishment-jsonl-gzip", "canonical-service-jsonl", "business-assertion-jsonl-gzip", "business-relationship-jsonl-gzip", "registry-zip-coverage-jsonl", "dataset-manifest-json"],
  "allowed_hosts": [],
  "redirect_policy": "deny",
  "provider_budget_key": "local-registry-reconciliation",
  "resource_class": "cpu-disk",
  "execution_limits": {
    "network_requests": 0,
    "input_partitions": 101,
    "parallel_partitions": 1
  },
  "retry": "Rerun from immutable source pointers; no external requests or partial retry side effects occur.",
  "checkpoint": "Inputs and outputs are checksummed; publication uses a run-scoped staging directory and atomic current pointer.",
  "idempotency": "Entity IDs derive from source candidates and assertion/relationship IDs are deterministic hashes of source-backed facts.",
  "cancellation": "Stop streaming at the current record; no current pointer is changed until the complete release is published.",
  "source_policy": "Inherited per assertion from each contributing source policy; current releases use USDA SNAP, CMS NPPES, FDIC BankFind, NCUA final quarterly, and USDA FSIS active MPI public normalized policies.",
  "retention_profile": "Retain immutable public registry releases until an approved retention operation removes them.",
  "produced_entities": ["organization", "physical_site", "establishment", "service"],
  "produced_identifiers": ["canonical-entity-id", "assertion-id", "relationship-id", "usda-snap-record-id", "npi", "fdic-certificate", "fdic-location-unique-number", "ncua-charter-number", "ncua-site-id-within-charter", "fsis-establishment-id", "fsis-establishment-number", "zip5", "zcta5"]
}
