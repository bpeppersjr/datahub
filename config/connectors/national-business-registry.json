ized-chicago-active-business-license-site-jsonl-gzip", "chicago-active-business-license-zip-coverage-jsonl", "normalized-dc-basic-business-license-site-jsonl-gzip", "dc-basic-business-license-zip-coverage-jsonl", "normalized-ca-abc-active-license-site-jsonl-gzip", "ca-abc-active-license-zip-coverage-jsonl", "normalized-nyc-dcwp-active-license-site-jsonl-gzip", "nyc-dcwp-active-license-zip-coverage-jsonl", "usps-operational-zip-assignment-jsonl"],
