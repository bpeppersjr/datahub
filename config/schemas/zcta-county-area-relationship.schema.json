{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cotive.local/schemas/zcta-county-area-relationship.schema.json",
  "title": "ZCTA to county polygon-area relationship",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "relationship_id",
    "relationship_type",
    "zcta_geo_id",
    "zcta",
    "county_geo_id",
    "county_geoid",
    "county_name",
    "state_geo_id",
    "state_fips",
    "county_fips",
    "intersection_area_m2",
    "zcta_polygon_area_m2",
    "raw_share_of_zcta_polygon_area",
    "normalized_share_of_matched_zcta_area",
    "material_intersection",
    "material_intersection_minimum_share",
    "allocation_semantics",
    "transformation_version"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "relationship_id": { "type": "string", "pattern": "^zcta-county-area:[0-9]{5}:[0-9]{5}$" },
    "relationship_type": { "const": "zcta_polygon_intersects_county_equivalent" },
    "zcta_geo_id": { "type": "string", "pattern": "^zcta:[0-9]{5}$" },
    "zcta": { "type": "string", "pattern": "^[0-9]{5}$" },
    "county_geo_id": { "type": "string", "pattern": "^county:[0-9]{5}$" },
    "county_geoid": { "type": "string", "pattern": "^[0-9]{5}$" },
    "county_name": { "type": "string", "minLength": 1 },
    "state_geo_id": { "type": "string", "pattern": "^state:[0-9]{2}$" },
    "state_fips": { "type": "string", "pattern": "^[0-9]{2}$" },
    "county_fips": { "type": "string", "pattern": "^[0-9]{3}$" },
    "intersection_area_m2": { "type": "number", "exclusiveMinimum": 0 },
    "zcta_polygon_area_m2": { "type": "number", "exclusiveMinimum": 0 },
    "raw_share_of_zcta_polygon_area": { "type": "number", "exclusiveMinimum": 0 },
    "normalized_share_of_matched_zcta_area": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "material_intersection": { "type": "boolean" },
    "material_intersection_minimum_share": { "const": 0.001 },
    "allocation_semantics": { "const": "polygon-area-only-not-business-location" },
    "transformation_version": { "const": "us-census-zcta-jurisdiction-crosswalk@1.0.0" }
  }
}
