{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Edition-bound exact Census NAICS reference record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "edition",
    "naics_code",
    "code_kind",
    "digit_count",
    "title",
    "trilateral_marker",
    "change_indicator",
    "source_row",
    "source_url",
    "authority_scope",
    "transformation_version",
    "policy_id",
    "source_artifact_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "edition": {
      "enum": [
        1997,
        2002,
        2007,
        2012,
        2017,
        2022
      ]
    },
    "naics_code": {
      "type": "string",
      "pattern": "^(?:[0-9]{2,6}|31-33|44-45|48-49)$"
    },
    "code_kind": {
      "enum": [
        "exact-code",
        "combined-sector",
        "source-program-unclassified"
      ]
    },
    "digit_count": {
      "enum": [
        null,
        2,
        3,
        4,
        5,
        6
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 511
    },
    "trilateral_marker": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "change_indicator": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\*{1,4}$"
    },
    "source_row": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4999
    },
    "source_url": {
      "type": "string"
    },
    "authority_scope": {
      "enum": [
        "census-susb-published-industry-vocabulary",
        "census-naics-united-states-structure"
      ]
    },
    "transformation_version": {
      "const": "us-census-naics-reference@1.0.0"
    },
    "policy_id": {
      "const": "us-census-naics-reference"
    },
    "source_artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
