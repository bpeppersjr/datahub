{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cotive.local/schemas/mississippi-business-report-organization.schema.json",
  "title": "Mississippi Business Report organization-registration candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_record_id", "jurisdiction", "business_id", "organization_name", "principal_administrative_address", "provenance", "export_policy", "claims"],
  "properties": {
    "schema_version": {"const": "mississippi-business-report-normalizer@1.0.0"}, "source_record_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "jurisdiction": {"const": "MS"},
    "business_id": {"type": "string", "pattern": "^\\d{6,7}$"}, "organization_name": {"type": "string", "minLength": 1}, "other_business_names": {"type": "array", "maxItems": 2, "items": {"type": "string", "minLength": 1}},
    "profile_type": {"type": ["string", "null"]}, "domicile_type": {"type": ["string", "null"]}, "registry_status": {"type": ["string", "null"]}, "naics_codes": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1}}, "formation_date": {"type": ["string", "null"]},
    "principal_administrative_address": {"type": "object", "additionalProperties": false, "required": ["address_line", "city", "state", "county", "zip5", "zip4"], "properties": {"address_line": {"type": ["string", "null"]}, "city": {"type": ["string", "null"]}, "state": {"type": ["string", "null"]}, "county": {"type": ["string", "null"]}, "zip5": {"type": ["string", "null"], "pattern": "^\\d{5}$"}, "zip4": {"type": ["string", "null"], "pattern": "^\\d{4}$"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["package_id", "observed_at", "original_workbook_sha256", "derived_records_sha256", "transformation_version", "representation"], "properties": {"package_id": {"type": "string"}, "observed_at": {"type": "string", "format": "date-time"}, "original_workbook_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "derived_records_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "transformation_version": {"type": "string"}, "representation": {"const": "operator-derived-jsonl"}}},
    "export_policy": {"const": "local-review-only"},
    "claims": {"type": "object", "additionalProperties": false, "required": ["organization_registration_evidence", "principal_address_role", "source_native", "source_authenticity_verified", "reproducible_extraction_verified", "statewide_complete", "current_operation_verified", "physical_site_verified", "redistribution_authorized", "national_admission_performed", "admission_eligible", "production_enrollment", "current_pointer_written"], "properties": {"organization_registration_evidence": {"const": true}, "principal_address_role": {"const": "administrative-registration-evidence"}, "source_native": {"const": false}, "source_authenticity_verified": {"const": false}, "reproducible_extraction_verified": {"const": false}, "statewide_complete": {"const": false}, "current_operation_verified": {"const": false}, "physical_site_verified": {"const": false}, "redistribution_authorized": {"const": false}, "national_admission_performed": {"const": false}, "admission_eligible": {"const": false}, "production_enrollment": {"const": false}, "current_pointer_written": {"const": false}}}
  }
}
