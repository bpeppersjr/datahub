{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cotive.local/schemas/overture-us-place.schema.json",
  "title": "Normalized Overture U.S. place",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "normalized_record_id", "external_identifiers", "names", "classification", "source_status", "reported_address", "geocode", "source_records", "entity_candidates", "provenance", "privacy", "export_policy"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "normalized_record_id": { "type": "string", "pattern": "^overture-us-place:[0-9a-f-]{36}$" },
    "external_identifiers": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "names": { "type": "object" },
    "classification": { "type": "object" },
    "source_status": { "type": "object" },
    "reported_address": { "type": "object" },
    "geocode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude", "source"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "source": { "const": "overture-place-point" }
      }
    },
    "websites": { "type": "array", "items": { "type": "string" } },
    "brand": { "type": ["object", "null"] },
    "source_records": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "entity_candidates": { "type": "object" },
    "provenance": { "type": "object" },
    "privacy": { "type": "object" },
    "export_policy": { "const": "local-review-only" }
  }
}
