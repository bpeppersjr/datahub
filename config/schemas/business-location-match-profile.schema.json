{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cotive.local/schemas/business-location-match-profile.schema.json",
  "title": "Business Location Match Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_version", "profile_id", "zip_code", "site_entity_id", "establishment_entity_id", "organization_entity_id", "address", "normalized_address", "address_match_key_sha256", "names", "primary_name_match_key_sha256", "geocode", "external_identifiers", "source_status", "observed_at", "source", "export_policy"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "profile_version": { "const": "business-location-match-profile@1.1.0" },
    "profile_id": { "type": "string", "pattern": "^location-profile:[a-f0-9]{32}$" },
    "zip_code": { "type": "string", "pattern": "^[0-9]{5}$" },
    "site_entity_id": { "type": "string", "pattern": "^site:[A-Za-z0-9_-]+$" },
    "establishment_entity_id": { "type": "string", "pattern": "^establishment:[A-Za-z0-9_-]+$" },
    "organization_entity_id": { "type": ["string", "null"] },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["street", "unit_or_additional", "city", "state", "zip_code", "postal_code", "zip4", "county_name"],
      "properties": {
        "street": { "type": ["string", "null"] },
        "unit_or_additional": { "type": ["string", "null"] },
        "city": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "zip_code": { "type": "string", "pattern": "^[0-9]{5}$" },
        "postal_code": { "type": "string", "pattern": "^[0-9]{5}$" },
        "zip4": { "type": ["string", "null"], "pattern": "^[0-9]{4}$" },
        "county_name": { "type": ["string", "null"] }
      }
    },
    "normalized_address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "street", "unit", "city", "state", "zip_code", "complete", "match_key"],
      "properties": {
        "kind": { "enum": ["street", "po-box", "route", "unknown"] },
        "street": { "type": ["string", "null"] },
        "unit": { "type": ["string", "null"] },
        "city": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "zip_code": { "type": "string", "pattern": "^[0-9]{5}$" },
        "complete": { "type": "boolean" },
        "match_key": { "type": ["string", "null"] }
      }
    },
    "address_match_key_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "names": { "type": "array", "items": { "type": "object" } },
    "primary_name_match_key_sha256": { "type": ["string", "null"] },
    "geocode": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["latitude", "longitude"], "properties": {
          "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
        } }
      ]
    },
    "external_identifiers": { "type": "array", "items": { "type": "object" } },
    "source_status": {},
    "observed_at": { "type": "string", "format": "date-time" },
    "source": { "type": "object", "additionalProperties": false, "required": ["source_id", "source_release_id", "source_record_id", "ingest_run_id", "transformation_version", "policy_id"], "properties": {
      "source_id": { "type": "string", "minLength": 1 },
      "source_release_id": { "type": "string", "minLength": 1 },
      "source_record_id": { "type": "string", "minLength": 1 },
      "source_record_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
      "observed_at": { "type": "string", "format": "date-time" },
      "retrieved_at": { "type": "string", "format": "date-time" },
      "ingest_run_id": { "type": "string", "minLength": 1 },
      "transformation_version": { "type": "string", "minLength": 1 },
      "policy_id": { "type": "string", "minLength": 1 }
    } },
    "export_policy": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "normalized_address": {
            "properties": { "complete": { "const": true } },
            "required": ["complete"]
          }
        }
      },
      "then": {
        "properties": {
          "normalized_address": { "properties": { "match_key": { "type": "string", "minLength": 1 } } },
          "address_match_key_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      },
      "else": {
        "properties": {
          "normalized_address": { "properties": { "match_key": { "type": "null" } } },
          "address_match_key_sha256": { "type": "null" }
        }
      }
    }
  ]
}
