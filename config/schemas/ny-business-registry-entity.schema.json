{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datahub.local/schemas/ny-business-registry-entity.schema.json",
  "title": "Normalized New York Business Registry Active Entity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "normalized_record_id", "entity_candidates", "external_identifiers", "legal_name", "reported_location_address", "reported_address_coordinate", "geography", "registration_profile", "source_status", "observed_at", "provenance", "export_policy"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "normalized_record_id": { "type": "string", "pattern": "^ny-business-registry:organization:[0-9]{1,8}$" },
    "entity_candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "identity_status"],
      "properties": {
        "organization_id": { "type": "string", "pattern": "^organization:ny_dos_id_[0-9]{1,8}$" },
        "identity_status": { "const": "provisional" }
      }
    },
    "external_identifiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "value", "source_field"],
        "properties": {
          "type": { "const": "ny_dos_id" },
          "value": { "type": "string", "pattern": "^[0-9]{1,8}$" },
          "source_field": { "const": "dos_id" }
        }
      }
    },
    "legal_name": { "type": "string", "minLength": 1 },
    "reported_location_address": { "type": "object" },
    "reported_address_coordinate": { "type": "null" },
    "geography": { "type": "object" },
    "registration_profile": { "type": "object" },
    "source_status": {
      "type": "object",
      "required": ["value", "status_class", "semantics"],
      "properties": {
        "value": { "const": "included-in-new-york-active-corporations-monthly-extract-as-of-retrieval" },
        "status_class": { "const": "active-only-monthly-extract-membership" },
        "semantics": { "const": "general-public-knowledge-only-not-proof-of-current-legal-status-operations-or-an-open-storefront" }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "provenance": { "type": "object" },
    "export_policy": { "const": "public-open-ny-terms" }
  }
}
