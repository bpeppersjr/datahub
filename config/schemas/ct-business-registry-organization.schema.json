{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datahub.local/schemas/ct-business-registry-organization.schema.json",
  "title": "Normalized Connecticut Business Registry Active Organization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "normalized_record_id", "entity_candidates", "external_identifiers", "legal_name", "other_names", "reported_business_address", "reported_address_coordinate", "geography", "registration_profile", "source_status", "observed_at", "provenance", "export_policy"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "normalized_record_id": { "type": "string", "pattern": "^ct-business-registry:organization:" },
    "entity_candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "identity_status"],
      "properties": {
        "organization_id": { "type": "string", "pattern": "^organization:ct_sots_record_[A-Za-z0-9_-]+$" },
        "identity_status": { "const": "provisional" }
      }
    },
    "external_identifiers": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "legal_name": { "type": "string", "minLength": 1 },
    "other_names": { "type": "array", "items": { "type": "object" } },
    "reported_business_address": { "type": "object" },
    "reported_address_coordinate": { "type": ["object", "null"] },
    "geography": { "type": "object" },
    "registration_profile": { "type": "object" },
    "source_status": {
      "type": "object",
      "required": ["value", "status", "semantics"],
      "properties": {
        "value": { "const": "listed-active-in-connecticut-business-registry-as-of-retrieval" },
        "status": { "const": "Active" },
        "semantics": { "const": "active-in-secretary-of-state-records-not-independent-proof-of-current-operations-or-good-standing" }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "provenance": { "type": "object" },
    "export_policy": { "const": "public" }
  }
}
