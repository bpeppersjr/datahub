    "retained_coordinate_count": {"type": "integer", "minimum": 0},
    "centroid_warning_count": {"type": "integer", "minimum": 0},
    "coordinate_accuracy_missing_count": {"type": "integer", "minimum": 0},
    "record_zcta_count": {"type": "integer", "minimum": 0},
    "record_nonpolygon_count": {"type": "integer", "minimum": 0},
    "air_association_count": {"type": "integer", "minimum": 0},
    "npdes_association_count": {"type": "integer", "minimum": 0},
    "rcra_association_count": {"type": "integer", "minimum": 0},
    "safe_drinking_water_association_count": {"type": "integer", "minimum": 0},
