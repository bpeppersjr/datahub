    "source": {"type": "object", "additionalProperties": false, "required": ["dataset_id", "release_id", "source_release_id", "source_date", "source_updated_at", "retrieved_at", "pointer_sha256", "manifest_sha256"], "properties": {"dataset_id": {"const": "epa-echo-active-facilities"}, "release_id": {"const": "epa-echo-20260903-002418917Z-3c1270e9"}, "source_release_id": {"const": "epa-echo-2026-08-30-382d612a42041dc0"}, "source_date": {"const": "2026-08-30"}, "source_updated_at": {"const": "2026-08-30T06:36:03.000Z"}, "retrieved_at": {"const": "2026-09-03T00:24:18.917Z"}, "pointer_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "geography": {"type": "object", "additionalProperties": false, "required": ["dataset_id", "release_id", "pointer_sha256", "manifest_sha256", "zcta_count"], "properties": {"dataset_id": {"const": "us-census-geography"}, "release_id": {"const": "us-census-geography-20260830-132803990Z-3629abc0"}, "pointer_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "zcta_count": {"const": 33791}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["source_records", "source_active_y_records", "source_unknown_blank_active_flag_records_excluded", "accepted_active_facilities", "quarantined_active_or_unexpected_records", "jurisdiction_rows", "state_dc_rows", "territory_rows", "positive_zip5_rows", "zip5_union_rows", "denominator_only_zip5_rows", "positive_source_zip_without_zcta", "active_facility_records_without_zcta", "positive_source_zip_without_published_zbp"], "properties": {"source_records": {"const": 3175741}, "source_active_y_records": {"const": 1659426}, "source_unknown_blank_active_flag_records_excluded": {"const": 1516315}, "accepted_active_facilities": {"const": 1517826}, "quarantined_active_or_unexpected_records": {"const": 141600}, "jurisdiction_rows": {"const": 56}, "state_dc_rows": {"const": 51}, "territory_rows": {"const": 5}, "positive_zip5_rows": {"const": 38401}, "zip5_union_rows": {"const": 41584}, "denominator_only_zip5_rows": {"const": 3183}, "positive_source_zip_without_zcta": {"const": 6594}, "active_facility_records_without_zcta": {"const": 27537}, "positive_source_zip_without_published_zbp": {"const": 5668}}}
  }
}
