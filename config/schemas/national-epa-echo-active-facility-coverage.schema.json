    "dataset_id": {"const": "national-epa-echo-active-facility-coverage"},
    "contracts": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "source_date": {"const": "2026-08-30"},
    "source": {"$ref": "#/$defs/source"},
    "geography": {"$ref": "#/$defs/geography"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "quarantine_reasons": {"type": "object", "additionalProperties": false, "required": ["missing-physical-address", "invalid-us-state-or-territory", "missing-registry-id", "missing-facility-identity"], "properties": {"missing-physical-address": {"const": 92746}, "invalid-us-state-or-territory": {"const": 33423}, "missing-registry-id": {"const": 15417}, "missing-facility-identity": {"const": 14}}},
    "export_policy": {"const": "governed-aggregate-only"},
    "privacy_warning": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"if": {"properties": {"scope": {"const": "national"}}}, "then": {"properties": {"code": {"type": "null"}}, "required": ["dataset_id", "contracts", "source_date", "source", "geography", "coverage", "quarantine_reasons", "export_policy", "privacy_warning"], "not": {"anyOf": [{"required": ["evidence_scope"]}, {"required": ["zcta_membership"]}]}}},
    {"if": {"properties": {"scope": {"const": "jurisdiction"}}}, "then": {"properties": {"code": {"type": "string", "pattern": "^[A-Z]{2}$"}}, "not": {"anyOf": [{"required": ["evidence_scope"]}, {"required": ["zcta_membership"]}, {"required": ["dataset_id"]}, {"required": ["source"]}, {"required": ["coverage"]}]}}},
    {"if": {"properties": {"scope": {"const": "zip5"}}}, "then": {"properties": {"code": {"type": "string", "pattern": "^[0-9]{5}$"}}, "required": ["evidence_scope", "zcta_membership"], "not": {"anyOf": [{"required": ["dataset_id"]}, {"required": ["source"]}, {"required": ["coverage"]}]}}}
  ],
  "$defs": {
