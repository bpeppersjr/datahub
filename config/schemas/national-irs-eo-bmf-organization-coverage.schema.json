    "source": {"type": "object", "additionalProperties": false, "required": ["dataset_id", "release_id", "source_release_id", "source_date", "retrieved_at", "pointer_sha256", "manifest_sha256"], "properties": {"dataset_id": {"const": "irs-eo-bmf-organizations"}, "release_id": {"const": "irs-eo-bmf-20260903-003447217Z-565da6cd"}, "source_release_id": {"const": "irs-eo-bmf-2026-08-11-d272cdb9c6c4afef"}, "source_date": {"const": "2026-08-11"}, "retrieved_at": {"const": "2026-09-03T00:34:47.217Z"}, "pointer_sha256": {"const": "799f3dab2080f40225f2f41c830b433d721eea647e8981e65eca387e23c85148"}, "manifest_sha256": {"const": "999233d73e42eac72a094d1248d6790680d39d276c3a9e849a496d01ed5288f8"}}},
    "geography": {"type": "object", "additionalProperties": false, "required": ["dataset_id", "release_id", "pointer_sha256", "manifest_sha256", "zcta_count"], "properties": {"dataset_id": {"const": "us-census-geography"}, "release_id": {"const": "us-census-geography-20260830-132803990Z-3629abc0"}, "pointer_sha256": {"const": "5f89350482630a7d2e888772512aca36fdd21f68c8d3f01f1113dc6c2c400403"}, "manifest_sha256": {"const": "5426cae150c0fba64f8ff43a48ca39c4e78b5b4ba8a8007fbd211615540d1c8b"}, "zcta_count": {"const": 33791}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["source_records", "source_page_claimed_records", "accepted_current_exempt_organizations", "excluded_outside_supported_us_scope", "quarantined_records", "jurisdiction_rows", "state_dc_rows", "territory_rows", "positive_zip5_rows", "zip5_union_rows", "denominator_only_zip5_rows", "positive_source_zip_without_zcta", "organization_records_without_zcta", "positive_source_zip_without_published_zbp"], "properties": {"source_records": {"const": 1957340}, "source_page_claimed_records": {"const": 1957340}, "accepted_current_exempt_organizations": {"const": 1955841}, "excluded_outside_supported_us_scope": {"const": 1498}, "quarantined_records": {"const": 1}, "jurisdiction_rows": {"const": 56}, "state_dc_rows": {"const": 51}, "territory_rows": {"const": 5}, "positive_zip5_rows": {"const": 36950}, "zip5_union_rows": {"const": 39217}, "denominator_only_zip5_rows": {"const": 2267}, "positive_source_zip_without_zcta": {"const": 5103}, "organization_records_without_zcta": {"const": 143102}, "positive_source_zip_without_published_zbp": {"const": 3139}}}
  }
