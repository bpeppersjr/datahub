{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cotive.local/schemas/business-location-match-profile-legacy-v1.schema.json",
  "title": "Bounded legacy Business Location Match Profile v1.0 compatibility input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_version", "profile_id", "zip_code", "site_entity_id", "establishment_entity_id", "organization_entity_id", "address", "normalized_address", "address_match_key_sha256", "names", "primary_name_match_key_sha256", "location", "external_identifiers", "source_status", "observed_at", "source", "export_policy"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "profile_version": { "const": "business-location-match-profile@1.0.0" },
    "profile_id": { "type": "string", "pattern": "^location-profile:[a-f0-9]{32}$" },
    "zip_code": { "type": "string", "pattern": "^[0-9]{5}$" },
    "site_entity_id": { "type": "string", "pattern": "^site:[A-Za-z0-9_-]+$" },
    "establishment_entity_id": { "type": "string", "pattern": "^establishment:[A-Za-z0-9_-]+$" },
    "organization_entity_id": { "type": ["string", "null"], "pattern": "^organization:[A-Za-z0-9_-]+$" },
    "address": { "$ref": "#/$defs/address" },
    "normalized_address": { "type": "object", "additionalProperties": false, "required": ["kind", "street", "unit", "city", "state", "zip_code", "complete", "match_key"], "properties": {
      "kind": { "enum": ["street", "po-box", "route", "unknown"] }, "street": { "type": ["string", "null"] },
      "unit": { "type": ["string", "null"] }, "city": { "type": ["string", "null"] }, "state": { "type": ["string", "null"] },
      "zip_code": { "type": ["string", "null"], "pattern": "^[0-9]{5}$" }, "complete": { "type": "boolean" },
      "match_key": { "type": ["string", "null"] }
    } },
    "address_match_key_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "names": { "type": "array", "items": { "type": "object" } },
    "primary_name_match_key_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "location": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["type", "coordinates", "coordinate_reference_system"], "properties": {
          "type": { "const": "Point" },
          "coordinates": { "type": "array", "prefixItems": [{ "type": "number", "minimum": -180, "maximum": 180 }, { "type": "number", "minimum": -90, "maximum": 90 }], "minItems": 2, "maxItems": 2 },
          "coordinate_reference_system": { "const": "EPSG:4326" }
        } },
        { "type": "object", "additionalProperties": false, "required": ["latitude", "longitude"], "properties": {
          "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
          "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 }
        } }
      ]
    },
    "external_identifiers": { "type": "array", "items": { "type": "object" } },
    "source_status": {},
    "observed_at": { "type": "string", "format": "date-time" },
    "source": { "$ref": "#/$defs/source" },
    "export_policy": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "address": { "type": "object", "additionalProperties": false, "required": ["street", "unit_or_additional", "city", "state", "zip_code", "postal_code", "zip4", "county_name"], "properties": {
      "street": { "type": ["string", "null"] }, "unit_or_additional": { "type": ["string", "null"] },
      "city": { "type": ["string", "null"] }, "state": { "type": ["string", "null"] },
      "zip_code": { "type": "string", "pattern": "^[0-9]{5}$" }, "postal_code": { "type": "string", "pattern": "^[0-9]{5}$" },
      "zip4": { "type": ["string", "null"], "pattern": "^[0-9]{4}$" }, "county_name": { "type": ["string", "null"] }
    } },
    "source": { "type": "object", "additionalProperties": false, "required": ["source_id", "source_release_id", "source_record_id", "ingest_run_id", "transformation_version", "policy_id"], "properties": {
      "source_id": { "type": "string", "minLength": 1 }, "source_release_id": { "type": "string", "minLength": 1 },
      "source_record_id": { "type": "string", "minLength": 1 }, "ingest_run_id": { "type": "string", "minLength": 1 },
      "source_record_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
      "observed_at": { "type": "string", "format": "date-time" }, "retrieved_at": { "type": "string", "format": "date-time" },
      "transformation_version": { "type": "string", "minLength": 1 }, "policy_id": { "type": "string", "minLength": 1 }
    } }
  }
}
