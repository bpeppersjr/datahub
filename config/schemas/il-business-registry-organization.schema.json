{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datahub.local/schemas/il-business-registry-organization.schema.json",
  "title": "Normalized Illinois Business Registry Active Organization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "normalized_record_id", "entity_candidates", "external_identifiers", "legal_name", "other_names", "records_office_address", "geography", "registration_profile", "annual_report_evidence", "source_status", "observed_at", "provenance", "export_policy"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "normalized_record_id": { "type": "string", "pattern": "^il-business-registry:organization:(corporation|llc):[0-9]{8}$" },
    "entity_candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "identity_status"],
      "properties": {
        "organization_id": { "type": "string", "pattern": "^organization:il_sos_(corporation|llc)_[0-9]{8}$" },
        "identity_status": { "const": "provisional" }
      }
    },
    "external_identifiers": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "legal_name": { "type": "string", "minLength": 1 },
    "other_names": { "type": "array", "maxItems": 0 },
    "records_office_address": { "type": ["object", "null"] },
    "geography": { "type": "object" },
    "registration_profile": { "type": "object" },
    "annual_report_evidence": { "type": ["object", "null"] },
    "source_status": {
      "type": "object",
      "required": ["code", "label", "value", "semantics"],
      "properties": {
        "code": { "enum": ["00", "01"] },
        "value": { "const": "listed-goodstanding-or-reinstated-in-illinois-sos-daily-files" },
        "semantics": { "const": "source-registration-status-not-independent-proof-of-current-operations-or-a-physical-site" }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "provenance": { "type": "object" },
    "export_policy": { "const": "local-review-only" }
  }
}
