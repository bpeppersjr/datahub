{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datahub.local/schemas/ak-active-business-license.schema.json",
  "title": "Normalized Alaska Active Business License",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "normalized_record_id", "entity_candidates", "external_identifiers", "business_name", "physical_address", "geography", "license_profile", "source_status", "physical_line_2_disposition", "privacy", "observed_at", "provenance", "export_policy"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "normalized_record_id": { "type": "string", "pattern": "^ak-active-business-license:[1-9][0-9]{0,9}$" },
    "entity_candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "identity_status"],
      "properties": {
        "organization_id": { "type": "string", "pattern": "^organization:ak_dcced_business_license_[1-9][0-9]{0,9}$" },
        "physical_site_id": { "type": "string", "pattern": "^site:ak_dcced_business_license_[1-9][0-9]{0,9}$" },
        "establishment_id": { "type": "string", "pattern": "^establishment:ak_dcced_business_license_[1-9][0-9]{0,9}$" },
        "identity_status": { "const": "provisional" }
      }
    },
    "external_identifiers": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "object" } },
    "business_name": { "type": "string", "minLength": 1 },
    "physical_address": { "type": "object" },
    "geography": { "type": "object" },
    "license_profile": { "type": "object" },
    "source_status": {
      "type": "object",
      "required": ["value", "status", "semantics"],
      "properties": {
        "value": { "const": "active-in-alaska-business-license-download-as-of-retrieval" },
        "status": { "const": "Active (source-defined)" },
        "semantics": { "const": "active-alaska-business-license-required-for-the-privilege-of-engaging-in-business-not-independent-proof-of-continuous-operation-location-or-service-quality" }
      }
    },
    "physical_line_2_disposition": { "type": "string" },
    "privacy": { "type": "object" },
    "observed_at": { "type": "string", "format": "date-time" },
    "provenance": { "type": "object" },
    "export_policy": { "const": "local-review-only" }
  }
}
