{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cotive.local/schemas/business-entity-resolution-benchmark-label.schema.json",
  "title": "Business Entity-Resolution Benchmark Label",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "label", "reviewer_id", "reviewed_at", "evidence_note", "evidence_references"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "candidate_id": { "type": "string", "pattern": "^benchmark-candidate:[a-f0-9]{32}$" },
    "label": { "type": ["string", "null"], "enum": ["match", "non-match", "uncertain", "not-reviewable", null] },
    "reviewer_id": { "type": ["string", "null"], "minLength": 2, "maxLength": 100 },
    "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
    "evidence_note": { "type": ["string", "null"], "maxLength": 2000 },
    "evidence_references": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
  },
  "allOf": [
    {
      "if": { "properties": { "label": { "const": null } } },
      "then": {
        "properties": {
          "reviewer_id": { "type": "null" },
          "reviewed_at": { "type": "null" },
          "evidence_note": { "type": "null" },
          "evidence_references": { "maxItems": 0 }
        }
      },
      "else": {
        "properties": {
          "reviewer_id": { "type": "string", "minLength": 2, "maxLength": 100 },
          "reviewed_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    {
      "if": { "properties": { "label": { "enum": ["non-match", "uncertain", "not-reviewable"] } } },
      "then": { "properties": { "evidence_note": { "type": "string", "minLength": 1, "maxLength": 2000 } } }
    }
  ]
}
