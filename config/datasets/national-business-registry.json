{
  "dataset_id": "national-business-registry",
  "schema_version": "1.0.0",
  "title": "Governed National Business Registry",
  "status": "partial-source-release-implemented",
  "description": "Canonical organizations, brands, sites, establishments, services, relationships, and source assertions reconciled across authorized U.S. business data sources.",
  "entity_schema": "config/schemas/business-entity.schema.json",
  "assertion_schema": "config/schemas/business-assertion.schema.json",
  "relationship_schema": "config/schemas/business-relationship.schema.json",
  "location_match_profile_schema": "config/schemas/business-location-match-profile.schema.json",
  "required_foundations": ["us-census-geography", "census-zbp-baseline"],
  "implemented_source_layers": [
    {
      "dataset_id": "usda-snap-retailers",
      "scope": "current SNAP-authorized retailer locations",
      "layer": "public-record-level"
    },
    {
      "dataset_id": "cms-nppes-organizations",
      "scope": "active/reactivated organization NPIs and reported U.S. practice locations",
      "layer": "public-record-level-with-internal-raw-source"
    },
    {
      "dataset_id": "fdic-bankfind",
      "scope": "active FDIC-insured institutions and current indexed U.S. locations",
      "layer": "public-record-level"
    },
    {
      "dataset_id": "ncua-quarterly-credit-unions",
      "scope": "federally insured credit unions and valid reported U.S. locations in the final quarterly release",
      "layer": "public-record-level"
    },
    {
      "dataset_id": "fsis-active-mpi-establishments",
      "scope": "establishments in the current USDA FSIS active MPI directory and same-date demographic supplement",
      "layer": "public-record-level-with-internal-raw-source"
    },
    {
      "dataset_id": "epa-echo-active-facilities",
      "scope": "ECHO FAC_ACTIVE_FLAG=Y regulated facilities with valid reported U.S. physical addresses",
      "layer": "public-record-level-with-internal-raw-source"
    },
    {
      "dataset_id": "irs-eo-bmf-organizations",
      "scope": "organizations present in the current IRS EO BMF extract with supported U.S. or territory filing addresses",
      "layer": "public-organization-record-level-with-internal-raw-source"
    },
    {
      "dataset_id": "ct-business-registry-active-organizations",
      "scope": "organizations whose source status is Active in the Connecticut Business Registry, with reported business addresses retained as organization-only evidence",
      "layer": "public-state-registration-record-level-with-internal-selected-field-source"
    },
    {
      "dataset_id": "de-business-licenses-current",
      "scope": "current Delaware Division of Revenue license numbers grouped across consistent trade-name rows, with reported business addresses retained as organization-only evidence and conflicting groups quarantined",
      "layer": "public-aggregate-with-local-review-only-personal-data-minimized-record-level-source"
    },
    {
      "dataset_id": "ak-active-business-licenses",
      "scope": "Alaska DCCED source-defined active business-license organizations, with conditional provisional sites only for complete reported U.S. physical street addresses",
      "layer": "local-review-only-state-license-record-level-with-local-aggregate-review-required"
    },
    {
      "dataset_id": "co-business-registry-good-standing-or-delinquent-organizations",
      "scope": "organizations whose source status is Good Standing or Delinquent in the Colorado Business Entities dataset, with principal-office addresses retained as organization-only evidence and one invalid-identity source row quarantined",
      "layer": "public-state-registration-record-level-with-internal-selected-field-source"
    },
    {
      "dataset_id": "or-business-registry-active-registrations",
      "scope": "legal-entity and assumed-business-name registrations listed in Oregon's Active Businesses dataset, with principal-place addresses retained as organization-or-brand evidence",
      "layer": "public-state-registration-record-level-with-internal-selected-field-source"
    },
    {
      "dataset_id": "ia-business-registry-active-entities",
      "scope": "entities listed in Iowa's monthly Active Iowa Business Entities dataset, with home-office addresses and source geocodes retained as organization-only evidence",
      "layer": "public-state-registration-record-level-with-internal-personal-data-minimized-selected-field-source"
    },
    {
      "dataset_id": "ny-business-registry-active-entities",
      "scope": "entities listed in New York's monthly Active Corporations extract, with reported locations retained as organization-only evidence",
      "layer": "open-ny-state-registration-record-level-with-internal-personal-data-minimized-selected-field-source"
    },
    {
      "dataset_id": "fl-business-registry-quarterly-active-entities",
      "scope": "Florida Division-of-Corporations quarterly corporate records coded Active, with principal addresses retained as organization-only evidence and inactive/malformed rows explicitly excluded or quarantined",
      "layer": "public-state-registration-record-level-with-internal-personal-data-minimized-selected-field-source"
    },
    {
      "dataset_id": "pa-business-registry-active-registrations",
      "scope": "distinct organizations in Pennsylvania's active-registration dataset, with reported business addresses and portal geocodes retained as organization-only evidence under the publisher's statutory-overcount warning",
      "layer": "public-state-registration-record-level-with-internal-personal-data-minimized-selected-field-source"
    },
    {
      "dataset_id": "la-active-business-location-accounts",
      "scope": "City of Los Angeles Office of Finance source-defined active location accounts with reported business-location addresses and optional portal geocodes",
      "layer": "local-review-only-municipal-registration-location-record-level-with-public-aggregate-coverage"
    },
    {
      "dataset_id": "tx-active-sales-tax-outlets",
      "scope": "Texas Comptroller source-defined active sales-tax permit taxpayers and physical outlets",
      "layer": "local-review-only-state-permit-organization-and-location-record-level-with-public-aggregate-coverage"
    },
    {
      "dataset_id": "chicago-active-business-license-sites",
      "scope": "City of Chicago BACP account/site groups with AAI licenses expiring after the official current-view cutoff, with multiple licenses retained on one site",
      "layer": "local-review-only-municipal-license-organization-and-location-record-level-with-public-aggregate-coverage"
    },
    {
      "dataset_id": "dc-basic-business-license-sites",
      "scope": "District of Columbia DLCP Customer Number groups with source-defined Active Basic Business License activities, official MAR coordinate evidence, and multiple activities retained on one site",
      "layer": "local-review-only-municipal-license-organization-and-location-record-level-with-cc-by-4.0-attributed-public-aggregate-coverage"
    },
    {
      "dataset_id": "ca-abc-active-license-sites",
      "scope": "California ABC File Number groups with source-defined ACTIVE issued-license activities and premise addresses, with multiple license types retained on one site",
      "layer": "local-review-only-state-license-organization-and-location-record-level-with-attributed-public-aggregate-coverage"
    },
    {
      "dataset_id": "nyc-dcwp-active-license-sites",
      "scope": "NYC DCWP Business Unique ID groups with source-defined Active Premises licenses, with multiple licenses retained on one site",
      "layer": "local-review-only-municipal-license-organization-and-location-record-level-with-public-aggregate-coverage"
    },
    {
      "dataset_id": "fmcsa-active-us-company-census",
      "scope": "FMCSA source-designated active U.S./territory registrations with accepted reported principal-office addresses",
      "layer": "public-regulatory-record-level-with-internal-minimized-source"
    },
    {
      "dataset_id": "hud-usps-zip-crosswalk",
      "scope": "quarterly address-derived ZIP-to-county evidence",
      "layer": "credential-gated-awaiting-live-release"
    },
    {
      "dataset_id": "usps-operational-zip-assignments",
      "scope": "current PostalPro Area/District 5-digit ZIP assignment denominator reconciled against AISU routing rows",
      "layer": "local-restricted-connector-awaiting-explicit-authorized-use-basis-for-live-release"
    }
  ],
  "required_coverage_dimensions": [
    "authoritative ZIP validity evidence",
    "ZIP/ZCTA polygon or explicit no-polygon status",
    "employer-establishment denominator",
    "record-level source contribution",
    "industry coverage",
    "source freshness",
    "unresolved conflicts and gaps"
  ],
  "publication_rule": "No field is publishable without a source record, release, ingest run, transformation version, temporal scope, and policy profile.",
