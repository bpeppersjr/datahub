{
  "name": "cotive-collector",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run desktop",
    "dev:web": "concurrently --kill-others --names UI,RUNNER --prefix-colors cyan,magenta \"npm:dev:ui\" \"npm:runner\"",
    "dev:ui": "vinext dev",
    "runner": "node runner/server.mjs",
    "geography:build": "node scripts/build-us-geography.mjs",
    "geography:verify": "node scripts/verify-us-geography.mjs",
    "zcta-crosswalk:build": "node scripts/build-zcta-jurisdiction-crosswalk.mjs",
    "zcta-crosswalk:verify": "node scripts/verify-zcta-jurisdiction-crosswalk.mjs",
    "coverage-views:build": "node scripts/build-national-business-coverage-views.mjs",
    "coverage-views:verify": "node scripts/verify-national-business-coverage-views.mjs",
    "zbp:build": "node scripts/build-census-zbp.mjs",
    "zbp:verify": "node scripts/verify-census-zbp.mjs",
    "nonemployer:build": "node scripts/build-census-nonemployer.mjs",
    "nonemployer:verify": "node scripts/verify-census-nonemployer.mjs",
    "hud-usps:build": "node scripts/build-hud-usps-crosswalk.mjs",
    "hud-usps:verify": "node scripts/verify-hud-usps-crosswalk.mjs",
    "usps-zips:build": "node scripts/build-usps-operational-zip-assignments.mjs",
    "usps-zips:verify": "node scripts/verify-usps-operational-zip-assignments.mjs",
    "snap:build": "node scripts/build-usda-snap-retailers.mjs",
    "snap:verify": "node scripts/verify-usda-snap-retailers.mjs",
    "nppes:prepare": "node scripts/prepare-nppes-source.mjs",
    "nppes-org:build": "node scripts/build-cms-nppes-organizations.mjs",
    "nppes-org:verify": "node scripts/verify-cms-nppes-organizations.mjs",
    "fdic:build": "node scripts/build-fdic-bankfind.mjs",
    "fdic:verify": "node scripts/verify-fdic-bankfind.mjs",
    "ncua:build": "node scripts/build-ncua-quarterly.mjs",
    "ncua:verify": "node scripts/verify-ncua-quarterly.mjs",
    "fsis:build": "node scripts/build-fsis-mpi.mjs",
    "fsis:verify": "node scripts/verify-fsis-mpi.mjs",
    "echo:build": "node scripts/build-epa-echo.mjs",
    "echo:verify": "node scripts/verify-epa-echo.mjs",
    "irs-eo:build": "node scripts/build-irs-eo-bmf.mjs",
    "irs-eo:verify": "node scripts/verify-irs-eo-bmf.mjs",
    "ct-business:build": "node scripts/build-ct-business-registry.mjs",
    "ct-business:verify": "node scripts/verify-ct-business-registry.mjs",
    "co-business:build": "node scripts/build-co-business-registry.mjs",
    "co-business:verify": "node scripts/verify-co-business-registry.mjs",
    "or-business:build": "node scripts/build-or-business-registry.mjs",
    "or-business:verify": "node scripts/verify-or-business-registry.mjs",
    "ia-business:build": "node scripts/build-ia-business-registry.mjs",
    "ia-business:verify": "node scripts/verify-ia-business-registry.mjs",
    "ny-business:build": "node scripts/build-ny-business-registry.mjs",
    "ny-business:verify": "node scripts/verify-ny-business-registry.mjs",
    "fl-business:build": "node scripts/build-fl-business-registry.mjs",
    "fl-business:verify": "node scripts/verify-fl-business-registry.mjs",
    "fmcsa:build": "node scripts/build-fmcsa-company-census.mjs",
    "fmcsa:verify": "node scripts/verify-fmcsa-company-census.mjs",
    "registry:build": "node scripts/build-business-registry.mjs",
    "registry:verify": "node scripts/verify-business-registry.mjs",
    "entity-resolution:build": "node scripts/build-business-entity-resolution.mjs",
    "entity-resolution:verify": "node scripts/verify-business-entity-resolution.mjs",
    "entity-resolution:benchmark:build": "node scripts/build-entity-resolution-benchmark.mjs",
    "entity-resolution:benchmark:verify": "node scripts/verify-entity-resolution-benchmark.mjs",
    "entity-resolution:benchmark:evaluate": "node scripts/evaluate-entity-resolution-benchmark.mjs",
    "entity-resolution:benchmark:labels:publish": "node scripts/publish-entity-resolution-benchmark-labels.mjs",
    "entity-resolution:benchmark:labels:verify": "node scripts/verify-entity-resolution-benchmark-labels.mjs",
    "pharmacy:build": "node scripts/build-retail-pharmacy-directory.mjs",
    "desktop:build": "vite build --config vite.desktop.config.ts",
    "desktop": "npm run desktop:build && electron desktop/main.mjs",
    "build:web": "vinext build",
    "build": "npm run build:web && npm run desktop:build",
    "start": "npm run desktop",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern desktop-dist --ignore-pattern .next",
    "test": "node --test runner/*.test.mjs",
    "check": "npm run test && npm run lint && npm run build"
  },
  "dependencies": {
    "@turf/area": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "concurrently": "^10.0.5",
    "csv-parse": "^6.2.1",
    "next": "^16.3.3",
    "playwright": "^1.62.1",
    "polygon-clipping": "^0.15.7",
    "rbush": "^4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ssh2": "^1.17.0",
    "tesseract.js": "^6.0.1",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/workers-types": "5.20260831.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "electron": "^44.0.0",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.127.1"
  },
  "type": "module",
  "allowScripts": {
    "electron@44.0.0": true
  }
}
