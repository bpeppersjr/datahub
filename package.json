{
  "name": "datahub-atlas-runner",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names UI,RUNNER --prefix-colors cyan,magenta \"npm:dev:ui\" \"npm:runner\"",
    "dev:ui": "vinext dev",
    "runner": "node runner/server.mjs",
    "build": "vinext build",
    "start": "concurrently --kill-others --names UI,RUNNER --prefix-colors cyan,magenta \"vinext start\" \"npm:runner\"",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check": "npm run lint && npm run build"
  },
  "dependencies": {
    "concurrently": "^10.0.5",
    "csv-parse": "^6.2.1",
    "next": "^16.3.3",
    "playwright": "^1.62.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.3",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
